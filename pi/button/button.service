[Unit]
Description=Button Service
After=plotter.service
Wants=plotter.service

[Service]
User=ubuntu
Group=ubuntu
SupplementaryGroups=gpio
WorkingDirectory=/home/ubuntu/bsp/pi/button/
ExecStart=/home/ubuntu/bsp/.venv/bin/python /home/ubuntu/bsp/pi/button/button.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
